{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "gear:geode_goggles.player",
      "item": {
        "gear:geode_goggles": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/gear/armor/geode_goggles",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.player.armor.helmet"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = 0.0;",
        "animate": ["offset"]
      },
      "animations": {
        "offset": "animation.armor.helmet.offset"
      },
      "render_controllers": ["controller.render.armor"]
    }
  }
}
