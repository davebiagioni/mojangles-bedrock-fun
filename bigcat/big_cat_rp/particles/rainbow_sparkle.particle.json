{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "mymod:rainbow_sparkle",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.s = variable.size > 0 ? variable.size : 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          "0.45 * variable.s",
          "0.95 * variable.s",
          "0.45 * variable.s"
        ],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + variable.particle_random_2 * 0.6"
      },
      "minecraft:particle_initial_speed": "0.4 * variable.s",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "0.6 * variable.s",
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + variable.particle_random_3 * 0.05) * variable.s",
          "(0.07 + variable.particle_random_3 * 0.05) * variable.s"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              0,
              88
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.5 + 0.5 * math.cos(360 * (variable.particle_random_1 + variable.particle_age * 0.8))",
          "0.5 + 0.5 * math.cos(360 * ((variable.particle_random_1 + variable.particle_age * 0.8) - 0.333))",
          "0.5 + 0.5 * math.cos(360 * ((variable.particle_random_1 + variable.particle_age * 0.8) - 0.667))",
          "1.0"
        ]
      }
    }
  }
