        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.35 + variable.particle_random_3 * 0.15",
          "0.75 + variable.particle_random_3 * 0.2",
          "0.15",
          "0.85 * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
