          0,
          "-0.35 * variable.s",
          0
        ],
        "half_dimensions": [
          "0.35 * variable.s",
          "0.25 * variable.s",
          "0.35 * variable.s"
        ],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.6 + variable.particle_random_2 * 1.0"
      },
      "minecraft:particle_initial_speed": "0.15 * variable.s",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "0.12 * variable.s",
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.18 + variable.particle_age * 0.18) * variable.s",
          "(0.18 + variable.particle_age * 0.18) * variable.s"
